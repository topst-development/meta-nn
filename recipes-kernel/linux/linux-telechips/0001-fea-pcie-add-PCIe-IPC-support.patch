 #ifdef CONFIG_PCIE_DW_EP
+static s32 dolphin_pcie_edma_configure(struct dw_pcie *pci,
+		u32 size, u64 src, u64 dst, bool ch)
+{
+	s32 err = 0;
+
+	if (pci != NULL) {
+		struct dolphin_pcie *dp = to_dolphin_pcie(pci);
+		u32 reg, val, mask, shift;
+
+		shift = PCIE_DBI_DMA_CS_SHIFT;
+		mask = PCIE_DBI_DMA_CS_MASK;
+		reg = ch ? DBI_PCIE_DMA_WR_CH_CONTROL1 : DBI_PCIE_DMA_RD_CH_CONTROL1;
+		val = (dw_pcie_readl_dbi(pci, reg) & mask) >> shift;
+		if (val != EDMA_CS_RUNNING) {
+			mask = 0xFFU;
+			val = dolphin_pcie_readl(dp, DP_PCIE_REG_LINK, PCIE_LINK_CFG93) & ~mask;
+			val |= ch ? 0x0FU : 0xF0U;
+			dolphin_pcie_writel(dp, DP_PCIE_REG_LINK, PCIE_LINK_CFG93, val, mask);
+
+			dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_CTRL_DATA_ARB_PRIOR, 0x608U);
+			if (ch) {
+				/* Write Channel0 */
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WRITE_ENGINE_EN, 0x1U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WRITE_CHANNEL_ARB_WEIGHT_LOW, 0x20C41U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WRITE_INT_MASK, 0x0U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WR_CH_CONTROL1, 0x04000018U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WR_TRANSFER_SIZE, size);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WR_SAR_LOW, lower_32_bits(src));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WR_SAR_HIGH, upper_32_bits(src));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WR_DAR_LOW, lower_32_bits(dst));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WR_DAR_HIGH, upper_32_bits(dst));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_WRITE_DOORBELL, 0x0U);
+			} else {
+				/* Read Channel0 */
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_READ_ENGINE_EN, 0x1U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_READ_CHANNEL_ARB_WEIGHT_LOW, 0x20C41U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_READ_INT_MASK, 0x0U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_RD_CH_CONTROL1, 0x04000018U);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_RD_TRANSFER_SIZE, size);
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_RD_SAR_LOW, lower_32_bits(src));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_RD_SAR_HIGH, upper_32_bits(src));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_RD_DAR_LOW, lower_32_bits(dst));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_RD_DAR_HIGH, upper_32_bits(dst));
+				dw_pcie_writel_dbi(pci, DBI_PCIE_DMA_READ_DOORBELL, 0x0U);
+			}
+		} else {
+			err = -EAGAIN;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 dolphin_pcie_edma_wait_done(struct dw_pcie *pci, bool blocking)
+{
+	s32 err = 0;
+
+	if (pci != NULL) {
+		struct dolphin_pcie *dp = to_dolphin_pcie(pci);
+
+		if (blocking) {
+			struct timespec64 start, end, gap;
+
+			ktime_get_ts64(&start);
+			atomic_set(&dp->edma_done, 0);
+			while(atomic_read(&dp->edma_done) == 0) {
+				ktime_get_ts64(&end);
+				gap = timespec64_sub(end, start);
+				if ((timespec64_to_ns(&gap)/NSEC_PER_MSEC) > EDMA_TRANSFER_TIMEOUT_MSEC) {
+					break;
+				} else {
+					udelay(1);
+				}
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 dolphin_pcie_edma_transfer(struct pci_epc *epc,
+		__u32 size, __u64 src, __u64 dst, bool ch, bool blocking)
+{
+	s32 err = 0;
+
+	if (epc != NULL) {
+		struct dw_pcie_ep *ep = epc_get_drvdata(epc);
+		struct dw_pcie *pci = to_dw_pcie_from_ep(ep);
+
+		err = dolphin_pcie_edma_configure(pci, size, src, dst, ch);
+
+		if (err == 0) {
+			err = dolphin_pcie_edma_wait_done(pci, blocking);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(dolphin_pcie_edma_transfer);
+
+static irqreturn_t dolphin_pcie_edma_irq_handler(s32 irq, void *arg)
+{
+	struct dolphin_pcie *dp = (struct dolphin_pcie *)arg;
+	irqreturn_t ret = (irqreturn_t)IRQ_NONE;
+
+	(void)irq;
+
+	if (dp != NULL) {
+		struct dw_pcie *pci = dp->pci;
+		u32 status;
+
+		status = dolphin_pcie_readl(dp, DP_PCIE_REG_LINK, PCIE_LINK_CFG92);
+		if((status & 0xFFU) != 0x0U) {
+			u32 reg, val;
+
+			if ((status & 0x0FU) != 0x0U) {
+				reg = DBI_PCIE_DMA_WRITE_INT_STATUS;
+			} else {
+				reg = DBI_PCIE_DMA_READ_INT_STATUS;
+			}
+			val = dw_pcie_readl_dbi(pci, reg);
+			if ((val & 0x0FU) != 0x0U) {
+				/* update wait condition to release blocking */
+				atomic_set(&dp->edma_done, 1);
+
+				if ((status & 0x0FU) != 0x0U) {
+					reg = DBI_PCIE_DMA_WRITE_INT_CLEAR;
+				} else {
+					reg = DBI_PCIE_DMA_READ_INT_CLEAR;
+				}
+				dw_pcie_writel_dbi(pci, reg, val);
+			} else {
+				/* ABORT_INT_STATUS */
+			}
+
+			ret = (irqreturn_t)IRQ_HANDLED;
+		}
+	}
+
+	return ret;
+}
+
+static s32 dolphin_pcie_edma_init(struct dolphin_pcie *dp, struct platform_device *pdev)
+{
+	s32 err = 0;
+
+	if ((dp != NULL) && (pdev != NULL)) {
+		dp->edma_irq = platform_get_irq(pdev, 1);
+		if (dp->edma_irq < (s32)0) {
+			err = -ENODEV;
+		} else {
+			err = devm_request_irq(&pdev->dev,
+					(u32)dp->edma_irq, dolphin_pcie_edma_irq_handler,
+					IRQF_SHARED, "telechips-pcie-edma",
+					dp);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
