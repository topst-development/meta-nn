diff --git a/drivers/net/ipc_netdev.c b/drivers/net/ipc_netdev.c
new file mode 100644
index 000000000000..61b936ae1504
--- /dev/null
+++ b/drivers/net/ipc_netdev.c
@@ -0,0 +1,319 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/ethtool.h>
+#include <linux/init.h>
+#include <linux/rtnetlink.h>
+#include <linux/net_tstamp.h>
+#include <net/rtnetlink.h>
+#include <linux/u64_stats_sync.h>
+#include <linux/soc/telechips/pci_ipc.h>
+
+#define DRV_NAME	"ipc"
+#define DRV_VERSION	"0.1"
+
+struct ipc_netdev_info_t {
+	struct net_device *dev;
+};
+
+struct ipc_netdev_private {
+	struct ipc_netdev_info_t *info;
+};
+
+static __s32 ipc_netdev_rx(void *dev, void *data, __u32 size)
+{
+	struct net_device *ndev = (struct net_device *)dev;
+	s32 err = (s32)0;
+
+	if (ndev != NULL) {
+		struct sk_buff *skb = dev_alloc_skb(size);
+
+		if (skb != NULL) {
+			if(size == 0U) {
+				ndev->stats.rx_length_errors++;
+			} else {
+				skb_reserve(skb, NET_IP_ALIGN);
+				(void)memcpy(skb_put(skb, size), data, size);
+				skb->ip_summed = CHECKSUM_NONE;
+				skb->protocol = eth_type_trans(skb, ndev);
+
+				err = netif_rx_ni(skb);
+				if(err != NET_RX_SUCCESS) {
+					dev_kfree_skb(skb);
+					ndev->stats.rx_errors++;
+					ndev->stats.rx_dropped++;
+				} else {
+					ndev->stats.rx_packets++;
+					ndev->stats.rx_bytes += size;
+				}
+			}
+		} else {
+			ndev->stats.rx_errors++;
+			ndev->stats.rx_frame_errors++;
+			err = -ENOMEM;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static int ipc_netdev_register_callback(struct net_device *dev)
+{
+	s32 err = (s32)0;
+
+	if (dev != NULL) {
+		err = pci_ipc_register_callback(dev, ipc_netdev_rx);
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static netdev_tx_t ipc_netdev_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+	netdev_tx_t ret = NETDEV_TX_BUSY;
+
+	if ((skb != NULL) &&
+			(ndev != NULL)) {
+		if(pci_ipc_write_data_nodev(skb->data, skb->len) != (s32)0) {
+			ndev->stats.tx_errors++;
+			ndev->stats.tx_aborted_errors++;
+			ret = NETDEV_TX_BUSY;
+		} else {
+			ndev->stats.tx_packets++;
+			ndev->stats.tx_bytes += skb->len;
+
+			skb_tx_timestamp(skb);
+			dev_kfree_skb(skb);
+			ret = NETDEV_TX_OK;
+		}
+	}
+
+	return ret;
+}
+
+static int ipc_netdev_open(struct net_device *dev)
+{
+	s32 err = (s32)0;
+
+	if (dev != NULL) {
+		netif_start_queue(dev);
+	} else {
+		err = -ENODEV;
+	}
+
+	return err;
+}
+
+static int ipc_netdev_release(struct net_device *dev)
+{
+	if (dev != NULL) {
+		netif_stop_queue(dev);
+	}
+
+	return 0;
+}
+
+static int ipc_netdev_change_mtu(struct net_device *dev, int new_mtu)
+{
+	s32 err = (s32)0;
+
+	if (dev != NULL) {
+		u32 mtu, max_mtu;
+
+		max_mtu = dev->max_mtu - (u32)ETH_HLEN;
+		if (!__builtin_add_overflow(new_mtu, 0, &mtu)) {
+			if (mtu <= max_mtu) {
+				dev->mtu = mtu;
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static int ipc_netdev_change_carrier(struct net_device *dev, bool new_carrier)
+{
+	s32 err = (s32)0;
+
+	if (dev != NULL) {
+		if (new_carrier) {
+			netif_carrier_on(dev);
+		} else {
+			netif_carrier_off(dev);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static const struct net_device_ops ipc_netdev_ops = {
+	.ndo_open		= ipc_netdev_open,
+	.ndo_stop		= ipc_netdev_release,
+	.ndo_start_xmit		= ipc_netdev_xmit,
+	.ndo_change_mtu		= ipc_netdev_change_mtu,
+	.ndo_set_mac_address	= eth_mac_addr,
+	.ndo_change_carrier		= ipc_netdev_change_carrier,
+};
+
+static void ipc_netdev_get_drvinfo(struct net_device *dev,
+			      struct ethtool_drvinfo *info)
+{
+	(void)dev;
+
+	if (info != NULL) {
+		(void)strlcpy(info->driver, DRV_NAME, sizeof(info->driver));
+		(void)strlcpy(info->version, DRV_VERSION, sizeof(info->version));
+	}
+}
+
+static const struct ethtool_ops ipc_netdev_ethtool_ops = {
+	.get_drvinfo            = ipc_netdev_get_drvinfo,
+	.get_ts_info		= ethtool_op_get_ts_info,
+};
+
+static void ipc_netdev_setup(struct net_device *dev)
+{
+	if (dev != NULL) {
+		ether_setup(dev);
+
+		/* Initialize the device structure. */
+		dev->netdev_ops = &ipc_netdev_ops;
+		dev->ethtool_ops = &ipc_netdev_ethtool_ops;
+		dev->needs_free_netdev = true;
+
+		/* Fill in device structure with ethernet-generic values. */
+		dev->flags &= ~((u32)IFF_MULTICAST);
+		dev->features = NETIF_F_HIGHDMA;
+		dev->hw_features = dev->features;
+		eth_hw_addr_random(dev);
+
+		dev->min_mtu = 0;
+		dev->max_mtu = ETH_MAX_MTU;
+		dev->mtu = dev->max_mtu - (u32)ETH_HLEN; 
+	}
+}
+
+static int ipc_netdev_validate(struct nlattr *tb[], struct nlattr *data[],
+			  struct netlink_ext_ack *extack)
+{
+	s32 err = (s32)0;
+
+	(void)data;
+	(void)extack;
+
+	if (tb[IFLA_ADDRESS] != NULL) {
+		if (nla_len(tb[IFLA_ADDRESS]) == ETH_ALEN) {
+			err = -EINVAL;
+		} else {
+			if (!is_valid_ether_addr(nla_data(tb[IFLA_ADDRESS]))) {
+				err = -EADDRNOTAVAIL;
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static struct rtnl_link_ops ipc_netdev_link_ops __read_mostly = {
+	.kind		= DRV_NAME,
+	.setup		= ipc_netdev_setup,
+	.validate	= ipc_netdev_validate,
+};
+
+static int __init ipc_netdev_init_one(void)
+{
+	struct net_device *dev;
+	s32 err = (s32)0;
+
+	dev = alloc_netdev(sizeof(struct ipc_netdev_private), "ipc%d",
+			NET_NAME_ENUM, ipc_netdev_setup);
+	if (dev != NULL) {
+		struct ipc_netdev_private *priv = netdev_priv(dev);
+		struct ipc_netdev_info_t *info;
+
+		info = kzalloc(sizeof(struct ipc_netdev_info_t), GFP_KERNEL);
+		if (info != NULL) {
+			/* Set private data */
+			priv->info = info;
+
+			/* Register net device */
+			dev->rtnl_link_ops = &ipc_netdev_link_ops;
+			err = register_netdevice(dev);
+			if (err < (s32)0) {
+				free_netdev(dev);
+			} else {
+				err = dev_open(dev, NULL);
+			}
+
+			if (err == (s32)0) {
+				err = ipc_netdev_register_callback(dev);
+			}
+		} else {
+			err = -ENOMEM;
+		}
+	} else {
+		err = -ENOMEM;
+	}
+
+	return err;
+}
+
+static s32 ipc_netdev_register_rtnl_link(void)
+{
+	s32 err;
+
+	err = __rtnl_link_register(&ipc_netdev_link_ops);
+	if (err == (s32)0) {
+		err = ipc_netdev_init_one();
+		(void)cond_resched();
+
+		if (err < 0) {
+			__rtnl_link_unregister(&ipc_netdev_link_ops);
+		}
+	}
+	
+	return err;
+}
+
+static int __init ipc_netdev_init_module(void)
+{
+	s32 err;
+
+	down_write(&pernet_ops_rwsem);
+	rtnl_lock();
+
+	err = ipc_netdev_register_rtnl_link();
+
+	rtnl_unlock();
+	up_write(&pernet_ops_rwsem);
+
+	return err;
+}
+
+static void __exit ipc_netdev_cleanup_module(void)
+{
+	rtnl_link_unregister(&ipc_netdev_link_ops);
+}
+
+module_init(ipc_netdev_init_module);
+module_exit(ipc_netdev_cleanup_module);
+MODULE_LICENSE("GPL");
+
+MODULE_ALIAS_RTNL_LINK(DRV_NAME);
+MODULE_VERSION(DRV_VERSION);
