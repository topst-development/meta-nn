+/* SPDX-License-Identifier: GPL-2.0+ WITH Linux-syscall-note */
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#ifndef PCI_IPC_H
+#define PCI_IPC_H
+
+enum pci_ipc_commands {
+	PCI_IPC_CMD_WRITE =		0,
+	PCI_IPC_CMD_READ =		1,
+	PCI_IPC_CMD_MAX =		2,
+};
+
+/* Ioctl data */
+struct pci_ipc_params {
+	__u64		addr;		/* cpu address */
+	enum pci_ipc_commands		cmd;		/* command */
+	__u32		size;		/* payload size */
+};
+
+/* Ioctl commands */
+#define IOCTL_PCIE_IPC_TRANSPORT_DATA _IOWR('T', 1, struct pci_ipc_params)
+#define IOCTL_PCIE_IPC_TRANSPORT_DATA_KERNEL _IOWR('T', 2, struct pci_ipc_params)
+
+/* for only kernel */
+typedef __s32 (*pci_ipc_callback_t)(void *dev, void *data, __u32 size);
+extern __s32 pci_ipc_register_callback(void *cb_data, pci_ipc_callback_t cb_func);
+extern __s32 pci_ipc_write_data_nodev(void *data, __u32 size);
+#endif		/* PCI_IPC_H */
+
