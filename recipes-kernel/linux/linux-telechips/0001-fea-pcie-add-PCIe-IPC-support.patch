diff --git a/drivers/misc/telechips/ipc/pci_ep_ipc.c b/drivers/misc/telechips/ipc/pci_ep_ipc.c
new file mode 100644
index 000000000000..81c2c30e6d5e
--- /dev/null
+++ b/drivers/misc/telechips/ipc/pci_ep_ipc.c
@@ -0,0 +1,655 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/dmaengine.h>
+#include <linux/time.h>
+#include <linux/pci.h>
+#include <linux/pci_ids.h>
+#include <linux/pci_regs.h>
+
+#include "pci_ipc_desc.h"
+#include "pci_ep_ipc.h"
+
+struct dma_desc_info {
+	dma_addr_t		dma_addr;
+	void		*virt_addr;
+	size_t		size;
+	struct device 		*dev;
+};
+
+struct ep_ipc {
+	struct pci_dev		*pdev;
+	void __iomem		*bar[EP_IPC_MAX_CHANNEL];
+	s32		num_irqs;
+
+	struct work_struct		work;
+	struct mutex		lock;
+	size_t		alignment;
+
+	struct dma_desc_info		tx_descs[PCI_IPC_DESC_RING_SIZE];
+	struct dma_desc_info		rx_descs[PCI_IPC_DESC_RING_SIZE];
+	atomic_t		tx_pending;
+	atomic_t		rx_pending;
+
+	bool		use_netdev;
+	void		*cb_data;
+	pci_ipc_callback_t		cb_func;
+};
+
+static struct pci_dev *pdev_global = NULL;
+
+static s32 ep_ipc_netdev_callback(struct ep_ipc *ipc, void *buf, u32 size)
+{
+	s32 err = -EINVAL;
+
+	if ((ipc != NULL) &&
+			(buf != NULL)) {
+		if (ipc->cb_func != NULL) {
+			err = ipc->cb_func(ipc->cb_data, buf, size);
+		}
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_get_desc_idx(struct ep_ipc *ipc, enum pci_ep_ipc_channels ch)
+{
+	s32 idx = -EINVAL;
+
+	if ((ipc != NULL) && (ch < EP_IPC_MAX_CHANNEL)) {
+		if (ch == EP_IPC_READ_CHANNEL) {
+			idx = atomic_read(&ipc->rx_pending);
+			if (idx >= PCI_IPC_DESC_RING_SIZE) {
+				atomic_set(&ipc->rx_pending, 0);
+				idx = 0;
+			}
+		} else {
+			idx = atomic_read(&ipc->tx_pending);
+			if (idx >= PCI_IPC_DESC_RING_SIZE) {
+				atomic_set(&ipc->tx_pending, 0);
+				idx = 0;
+			}
+		}
+	} else {
+		idx = -EINVAL;
+	}
+
+	return idx;
+}
+
+static void ep_ipc_update_desc(struct ep_ipc *ipc, void *desc, enum pci_ep_ipc_channels ch, u32 size)
+{
+	if ((ipc != NULL) && (desc != NULL) &&
+			(size != 0U) && (ch < EP_IPC_MAX_CHANNEL)) {
+		u32 val, mask;
+
+		mask = PCI_IPC_DESC_CONTROL_OWN_MASK;
+		val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL) & ~mask;
+		if (ch == EP_IPC_READ_CHANNEL) {
+			pci_ipc_desc_writel(desc, PCI_IPC_DESC_CONTROL,
+					val);
+			atomic_inc(&ipc->rx_pending);
+		} else {
+			pci_ipc_desc_writel(desc,
+					PCI_IPC_DESC_SIZE, size);
+			val |= PCI_IPC_DESC_CONTROL_OWN_MASK;
+			pci_ipc_desc_writel(desc,
+					PCI_IPC_DESC_CONTROL, val);
+			atomic_inc(&ipc->tx_pending);
+		}
+	}
+}
+
+static s32 ep_ipc_read_data(struct ep_ipc *ipc, s32 rx_pending, u32 size)
+{
+	s32 err = 0;
+
+	if ((ipc != NULL) &&
+			(rx_pending >= 0) &&
+			(size != 0U)) {
+		struct dma_desc_info *desc = &ipc->rx_descs[rx_pending];
+		if (desc->virt_addr != NULL) {
+			/* Switch ownership to CPU */
+			dma_sync_single_for_cpu(desc->dev,
+					desc->dma_addr,
+					desc->size,
+					DMA_FROM_DEVICE);
+			if (ipc->use_netdev) {
+				err = ep_ipc_netdev_callback(ipc, desc->virt_addr, size);
+			}
+		} else {
+			err = -EINVAL;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_write_data(struct ep_ipc *ipc, void *buf, s32 idx, u32 size)
+{
+	s32 err = 0;
+
+	if ((ipc != NULL) && (buf != NULL) &&
+			(idx >= 0) && (size != 0U)) {
+		struct dma_desc_info *desc = &ipc->tx_descs[idx];
+
+		(void)memcpy(desc->virt_addr, buf, size);
+		dma_sync_single_for_device(desc->dev,
+				desc->dma_addr,
+				desc->size,
+				DMA_TO_DEVICE);
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static void ep_ipc_work_fn(struct work_struct *work)
+{
+	if (work != NULL) {
+		struct ep_ipc *ipc = container_of(work, struct ep_ipc, work);
+		enum pci_ep_ipc_channels ch = EP_IPC_READ_CHANNEL;
+		u32 val;
+
+		mutex_lock(&ipc->lock);
+
+		val = 0x0U;
+		do {
+			s32 rx_pending;
+
+			rx_pending = ep_ipc_get_desc_idx(ipc, ch);
+
+			if (rx_pending < 0) {
+				val = 0x0U;
+			} else {
+				u32 offset = ((u32)rx_pending * (u32)sizeof(struct pci_ipc_desc));
+
+				if (offset < (u32)pci_resource_len(ipc->pdev, ch)) {
+					void __iomem *desc = ipc->bar[ch] + offset;
+
+					val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL);
+					if ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) != 0x0U) {
+						u32 size = pci_ipc_desc_readl(desc, PCI_IPC_DESC_SIZE);
+
+						if (ep_ipc_read_data(ipc, rx_pending, size) == 0) {
+							/* Update the descriptor for TX */
+							ep_ipc_update_desc(ipc, desc, ch, size);
+						}
+					}
+				}
+			}
+		} while ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) != 0x0U);
+
+		mutex_unlock(&ipc->lock);
+	}
+}
+
+static irqreturn_t ep_ipc_irqhandler(int irq, void *dev_id)
+{
+	struct ep_ipc *ipc = (struct ep_ipc *)dev_id;
+	irqreturn_t ret = (irqreturn_t)IRQ_NONE;
+
+	(void)irq;
+
+	if (ipc != NULL) {
+		(void)schedule_work(&ipc->work);
+		ret = (irqreturn_t)IRQ_HANDLED;
+	}
+
+	return ret;
+}
+
+static struct ep_ipc *ep_ipc_alloc_dev(struct pci_dev *pdev)
+{
+	struct ep_ipc *ipc = NULL;
+
+	if (pdev != NULL) {
+		ipc = devm_kzalloc(&pdev->dev, (u32)sizeof(struct ep_ipc), GFP_KERNEL);
+		if (ipc != NULL) {
+			ipc->pdev = pdev;
+			ipc->alignment = SZ_64K;
+			ipc->use_netdev = false;
+			atomic_set(&ipc->tx_pending, 0);
+			atomic_set(&ipc->rx_pending, 0);
+			mutex_init(&ipc->lock);
+			INIT_WORK(&ipc->work, ep_ipc_work_fn);
+		}
+	}
+
+	return ipc;
+}
+
+static s32 ep_ipc_release_irq_vectors(struct ep_ipc *ipc)
+{
+	s32 err = 0;
+
+	if (ipc != NULL) {
+		struct pci_dev *pdev = ipc->pdev;
+		s32 idx;
+
+		for (idx = 0; idx < ipc->num_irqs; idx++) {
+			u32 irq;
+
+			if (!__builtin_add_overflow(pci_irq_vector(pdev, (u32)idx), 0, &irq)) {
+				if (irq > 0U) {
+					devm_free_irq(&pdev->dev, irq, ipc);
+				}
+			}
+		}
+		ipc->num_irqs = 0;
+		pci_free_irq_vectors(pdev);
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_alloc_irq_vectors(struct ep_ipc *ipc)
+{
+	s32 err = 0;
+
+	if (ipc != NULL) {
+		struct pci_dev *pdev = ipc->pdev;
+		s32 irq;
+
+		irq = pci_alloc_irq_vectors(pdev, 1, 32, PCI_IRQ_MSI);
+		if (irq < 0) {
+			dev_err(&pdev->dev, "Failed to get MSI interrupts\n");
+		} else {
+			ipc->num_irqs = irq;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_request_irq(struct ep_ipc *ipc)
+{
+	s32 err = 0;
+
+	if (ipc != NULL) {
+		struct pci_dev *pdev = ipc->pdev;
+		s32 idx;
+
+		for (idx = 0; idx < ipc->num_irqs; idx++) {
+			u32 irq;
+
+			if (!__builtin_add_overflow(pci_irq_vector(pdev, (u32)idx), 0, &irq)) {
+				err = devm_request_irq(&pdev->dev, irq,
+						ep_ipc_irqhandler,
+						IRQF_SHARED, "ep-ipc", ipc);
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static void ep_ipc_free_ipc_desc_resource(struct ep_ipc *ipc)
+{
+	if (ipc != NULL) {
+		s32 idx;
+
+		for (idx = 0; idx < PCI_IPC_DESC_RING_SIZE; idx++) {
+			struct dma_desc_info *desc = &ipc->tx_descs[idx];
+
+			if (desc->virt_addr != NULL) {
+				dma_free_coherent(desc->dev, desc->size,
+						desc->virt_addr, desc->dma_addr);
+			}
+		}
+
+		for (idx = 0; idx < PCI_IPC_DESC_RING_SIZE; idx++) {
+			struct dma_desc_info *desc = &ipc->rx_descs[idx];
+
+			if (desc->virt_addr != NULL) {
+				dma_free_coherent(desc->dev, desc->size,
+						desc->virt_addr, desc->dma_addr);
+			}
+		}
+	}
+}
+
+static s32 ep_ipc_alloc_desc_resources(struct ep_ipc *ipc)
+{
+	s32 err = 0;
+
+	if (ipc != NULL) {
+		struct pci_dev *pdev = ipc->pdev;
+		enum pci_ep_ipc_channels ch;
+		u32 idx;
+
+		for(ch = EP_IPC_WRITE_CHANNEL; ch < EP_IPC_MAX_CHANNEL; ch++) {
+			for (idx = 0; idx < PCI_IPC_DESC_RING_SIZE; idx++) {
+				struct dma_desc_info *desc = (ch == EP_IPC_READ_CHANNEL) ? 
+					&ipc->rx_descs[idx] : &ipc->tx_descs[idx];
+
+				desc->size = DMA_DESC_SIZE;
+				desc->dev = &pdev->dev;
+				desc->virt_addr = dma_alloc_coherent(desc->dev,
+						desc->size + ipc->alignment,
+						&desc->dma_addr,
+						GFP_KERNEL);
+				if (desc->virt_addr == NULL) {
+					err = -ENOMEM;
+					break;
+				}
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_init_descs(struct ep_ipc *ipc)
+{
+	s32 err = 0;
+
+	if (ipc != NULL) {
+		enum pci_ep_ipc_channels ch;
+		u32 idx;
+
+		for(ch = EP_IPC_WRITE_CHANNEL; ch < EP_IPC_MAX_CHANNEL; ch++) {
+			for (idx = 0; idx < PCI_IPC_DESC_RING_SIZE; idx++) {
+				void __iomem *base = ipc->bar[ch] + (idx * (u32)sizeof(struct pci_ipc_desc));
+				struct dma_desc_info *desc = (ch == EP_IPC_READ_CHANNEL) ?
+					&ipc->rx_descs[idx] : &ipc->tx_descs[idx];
+
+				if (desc != NULL) {
+					pci_ipc_desc_writel(base, PCI_IPC_DESC_ADDR_LOWER,
+							lower_32_bits(desc->dma_addr));
+					pci_ipc_desc_writel(base, PCI_IPC_DESC_ADDR_UPPER,
+							upper_32_bits(desc->dma_addr));
+					pci_ipc_desc_writel(base, PCI_IPC_DESC_SIZE, 0x0U);
+					pci_ipc_desc_writel(base, PCI_IPC_DESC_CONTROL, 0x0U);
+				}
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_init_bar(struct pci_dev *pdev)
+{
+	s32 err = 0;
+
+	if (pdev != NULL) {
+		struct ep_ipc *ipc = pci_get_drvdata(pdev);
+		enum pci_ep_ipc_channels ch;
+
+		for (ch = EP_IPC_WRITE_CHANNEL; ch < EP_IPC_MAX_CHANNEL; ch++) {
+			if ((pci_resource_flags(pdev, ch) & (u32)IORESOURCE_MEM) != 0x0U) {
+				ipc->bar[ch] = pci_ioremap_bar(pdev, ch);
+				if (IS_ERR_OR_NULL(ipc->bar[ch])) {
+					err = -ENODEV;
+				}
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_init_resources(struct pci_dev *pdev)
+{
+	s32 err = 0;
+
+	if (pdev != NULL) {
+		struct ep_ipc *ipc = pci_get_drvdata(pdev);
+
+		err = ep_ipc_init_bar(pdev);
+
+		if (err == 0) {
+			err = ep_ipc_alloc_desc_resources(ipc);
+		}
+
+		if (err == 0) {
+			err = ep_ipc_init_descs(ipc);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 ep_ipc_init_dev(struct pci_dev *pdev)
+{
+	s32 err = 0;
+
+	if (pdev != NULL) {
+		struct ep_ipc *ipc = pci_get_drvdata(pdev);
+
+		err = ep_ipc_alloc_irq_vectors(ipc);
+		if (err == 0) {
+			err = ep_ipc_request_irq(ipc);
+		}
+
+		if (err == 0) {
+			err = ep_ipc_init_resources(pdev);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static int ep_ipc_probe(struct pci_dev *pdev,
+				   const struct pci_device_id *ent)
+{
+	s32 err = 0;
+
+	(void)ent;
+
+	if (!pci_is_bridge(pdev)) {
+		struct ep_ipc *ipc = NULL;
+
+		ipc = ep_ipc_alloc_dev(pdev);
+		if (ipc != NULL) {
+			err = pci_enable_device(pdev);
+			if (err == 0) {
+				err = pci_request_regions(pdev, "ep-ipc");
+			}
+
+			if (err == 0) {
+				pci_set_master(pdev);
+				pci_set_drvdata(pdev, ipc);
+
+				/* Temporary */
+				pdev_global = pdev;
+				err = ep_ipc_init_dev(pdev);
+			}
+		} else {
+			err = -ENOMEM;
+		}
+	} else {
+		err = -ENODEV;
+	}
+
+	return err;
+}
+
+static void ep_ipc_remove(struct pci_dev *pdev)
+{
+	if (pdev != NULL) {
+		struct ep_ipc *ipc = pci_get_drvdata(pdev);
+		enum pci_ep_ipc_channels ch;
+
+		for (ch = EP_IPC_WRITE_CHANNEL; ch < EP_IPC_MAX_CHANNEL; ch++) {
+			if (ipc->bar[ch] != NULL) {
+				pci_iounmap(pdev, ipc->bar[ch]);
+			}
+		}
+
+		ep_ipc_free_ipc_desc_resource(ipc);
+		if (ep_ipc_release_irq_vectors(ipc) == 0) {
+			pci_release_regions(pdev);
+			pci_disable_device(pdev);
+		}
+	}
+}
+
+static const struct pci_device_id ep_ipc_tbl[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_SYNOPSYS, 0x750B) },
+	{ PCI_DEVICE(PCI_VENDOR_ID_SYNOPSYS, 0x8040) },
+	{ 0, } /* 0 terminated list. */
+};
+MODULE_DEVICE_TABLE(pci, ep_ipc_tbl);
+
+static struct pci_driver ep_ipc_driver = {
+	.name		= "ep-ipc",
+	.id_table	= ep_ipc_tbl,
+	.probe		= ep_ipc_probe,
+	.remove		= ep_ipc_remove,
+};
+
+s32 pci_ep_ipc_init(void)
+{
+	return pci_register_driver(&ep_ipc_driver);
+}
+
+s32 pci_ep_ipc_release(void)
+{
+	pci_unregister_driver(&ep_ipc_driver);
+	return 0;
+}
+
+static inline struct pci_dev *__get_pci_dev(void)
+{
+	return pdev_global;
+}
+
+s32 pci_ep_ipc_read_data(void *buf, __u32 size)
+{
+	s32 err = 0;
+
+	if ((buf != NULL) && (size > 0U)) {
+		struct pci_dev *pdev = __get_pci_dev();
+
+		if (pdev != NULL) {
+			struct ep_ipc *ipc = pci_get_drvdata(pdev);
+			enum pci_ep_ipc_channels ch = EP_IPC_READ_CHANNEL;
+			s32 rx_pending = ep_ipc_get_desc_idx(ipc, ch);
+			u32 val, offset;
+
+			if (rx_pending >= 0) {
+				offset = ((u32)rx_pending * (u32)sizeof(struct pci_ipc_desc));
+				if (offset < (u32)pci_resource_len(pdev, ch)) {
+					void __iomem *base = ipc->bar[ch] + offset;
+
+					val = pci_ipc_desc_readl(base, PCI_IPC_DESC_CONTROL);
+					if ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) != 0x0U) {
+						struct dma_desc_info *desc = &ipc->rx_descs[rx_pending];
+
+						if (desc != NULL) {
+							if (desc->virt_addr != NULL) {
+								(void)memcpy(buf, desc->virt_addr, size + ipc->alignment);
+
+								/* Update the descriptor for TX */
+								ep_ipc_update_desc(ipc, base, ch, size);
+							}
+						}
+					}
+				}
+			}
+		} else {
+			err = -ENODEV;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 pci_ep_ipc_write_data(void *buf, __u32 size)
+{
+	s32 err = 0;
+
+	if ((buf != NULL) && (size > 0U)) {
+		struct pci_dev *pdev = __get_pci_dev();
+
+		if (pdev != NULL) {
+			struct ep_ipc *ipc = pci_get_drvdata(pdev);
+			enum pci_ep_ipc_channels ch = EP_IPC_WRITE_CHANNEL;
+			s32 tx_pending;
+			u32 val, offset;
+
+			tx_pending= ep_ipc_get_desc_idx(ipc, ch);
+			if (tx_pending >= 0) {
+				offset = ((u32)tx_pending * (u32)sizeof(struct pci_ipc_desc));
+				if (offset < (u32)pci_resource_len(pdev, ch)) {
+					void __iomem *desc = ipc->bar[ch] + offset;
+
+					val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL);
+					if ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) == 0x0U) {
+						err = ep_ipc_write_data(ipc, buf, tx_pending, size);
+						if (err == 0) {
+							/* Update the descriptor for RX */
+							ep_ipc_update_desc(ipc, desc, ch, size);
+						}
+					}
+				}
+			}
+		} else {
+			err = -ENODEV;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 pci_ep_ipc_register_callback(void *cb_data, pci_ipc_callback_t cb_func)
+{
+	s32 err = 0;
+
+	if ((cb_data != NULL) && (cb_func != NULL)) {
+		struct pci_dev *pdev = __get_pci_dev();
+
+		if (pdev != NULL) {
+			struct ep_ipc *ipc = pci_get_drvdata(pdev);
+
+			ipc->cb_data = cb_data;
+			ipc->cb_func = cb_func;
+			ipc->use_netdev = true;
+		} else {
+			err = -ENODEV;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+MODULE_DESCRIPTION("PCI IPC HOST DRIVER");
+MODULE_AUTHOR("Jay Jeon <inbest@telechips.com>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/telechips/ipc/pci_ep_ipc.h b/drivers/misc/telechips/ipc/pci_ep_ipc.h
new file mode 100644
index 000000000000..9d10e8aedf68
--- /dev/null
+++ b/drivers/misc/telechips/ipc/pci_ep_ipc.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#ifndef	EP_IPC_H
+#define EP_IPC_H
+#include <linux/soc/telechips/pci_ipc.h>
+
+enum pci_ep_ipc_channels {
+	EP_IPC_WRITE_CHANNEL =		0,
+	EP_IPC_READ_CHANNEL =		1,
+	EP_IPC_MAX_CHANNEL =		2,
+};
+
+extern s32 pci_ep_ipc_init(void);
+extern s32 pci_ep_ipc_release(void);
+extern s32 pci_ep_ipc_read_data(void *buf, __u32 size);
+extern s32 pci_ep_ipc_write_data(void *buf, __u32 size);
+extern s32 pci_ep_ipc_register_callback(void *cb_data, pci_ipc_callback_t cb_func);
+#endif /* EP_IPC_H */
diff --git a/drivers/misc/telechips/ipc/pci_epf_ipc.c b/drivers/misc/telechips/ipc/pci_epf_ipc.c
new file mode 100644
index 000000000000..20ee1162b733
--- /dev/null
+++ b/drivers/misc/telechips/ipc/pci_epf_ipc.c
@@ -0,0 +1,708 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/pci_ids.h>
+#include <linux/configfs.h>
+#include <linux/pci-epc.h>
+#include <linux/pci-epf.h>
+#include <linux/pci_regs.h>
+#include <soc/telechips/dw_edma.h>
+
+#include "pci_ipc_desc.h"
+#include "pci_epf_ipc.h"
+
+struct epf_ipc_carrier {
+	void __iomem		*virt_addr;
+	phys_addr_t		phys_addr;
+	atomic_t		pending;
+};
+
+struct epf_ipc {
+	void __iomem		*bar[EPF_IPC_MAX_CHANNEL];
+	struct pci_epf		*epf;
+	const struct pci_epc_features *epc_features;
+
+	struct delayed_work	cmd_hdl;
+	struct workqueue_struct *rx_wq;
+
+	struct epf_ipc_carrier		carrier[EPF_IPC_MAX_CHANNEL];
+
+	bool use_netdev;
+	void *cb_data;
+	pci_ipc_callback_t cb_func;
+};
+
+static struct pci_epf *epf_global = NULL;
+
+static inline struct pci_epf *__get_pci_epf(struct pci_epf_driver *driver)
+{
+	(void)driver;
+	return epf_global;
+}
+
+static s32 epf_ipc_raise_irq(struct pci_epf *epf, u16 irq)
+{
+	s32 err = 0;
+
+	if (epf != NULL) {
+		struct pci_epc *epc = epf->epc;
+
+		err = pci_epc_raise_irq(epc, epf->func_no, PCI_EPC_IRQ_MSI, irq);
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_netdev_callback(struct epf_ipc *ipc, void *buf, u32 size)
+{
+	s32 err = 0;
+
+	if (ipc != NULL) {
+		if (ipc->cb_func != NULL) {
+			err = ipc->cb_func(ipc->cb_data, buf, size);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_get_desc_idx(struct epf_ipc *priv, enum epf_ipc_channels ch)
+{
+	s32 idx = 0;
+
+	if ((priv != NULL) &&
+			(ch < EPF_IPC_MAX_CHANNEL)) {
+		struct epf_ipc_carrier *carrier = &priv->carrier[ch];
+
+		idx = atomic_read(&carrier->pending);
+		if (idx >= PCI_IPC_DESC_RING_SIZE) {
+			atomic_set(&carrier->pending, 0);
+			idx = 0;
+		}
+	} else {
+		idx = -EINVAL;
+	}
+
+	return idx;
+}
+
+static void epf_ipc_update_desc(struct epf_ipc *priv, void *desc, enum epf_ipc_channels ch, u32 size)
+{
+	if ((priv != NULL) &&
+			(ch < EPF_IPC_MAX_CHANNEL)) {
+		struct epf_ipc_carrier *carrier = &priv->carrier[ch];
+		u32 val, mask;
+
+		mask = PCI_IPC_DESC_CONTROL_OWN_MASK;
+		val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL) & ~mask;
+		if (ch == EPF_IPC_READ_CHANNEL) {
+			/* Update the descriptor for TX */
+			pci_ipc_desc_writel(desc, PCI_IPC_DESC_CONTROL, val);
+		} else {
+			/* Update the descriptor for RX */
+			pci_ipc_desc_writel(desc, PCI_IPC_DESC_SIZE, size);
+
+			val |= mask;
+			pci_ipc_desc_writel(desc, PCI_IPC_DESC_CONTROL, val);
+		}
+
+		atomic_inc(&carrier->pending);
+	}
+}
+
+//#define USE_CPU_MEMCPY
+#ifdef USE_CPU_MEMCPY
+static s32 epf_ipc_memcpy(struct epf_ipc *ipc,
+	void *virt_addr,
+	phys_addr_t phys_addr,
+	u32 size,
+	enum epf_ipc_channels ch)
+{
+	s32 err = 0;
+
+	if ((ipc != NULL) &&
+			(virt_addr != NULL) &&
+			(phys_addr != 0x0ULL) &&
+			(size != 0U)) {
+		struct pci_epf *epf = ipc->epf;
+		struct pci_epc *epc = epf->epc;
+		struct epf_ipc_carrier *carrier = &ipc->carrier[ch];
+
+		err = pci_epc_map_addr(epc, epf->func_no, carrier->phys_addr, phys_addr, size);
+		if (err == 0) {
+			if (ch == EPF_IPC_READ_CHANNEL) {
+				memcpy_fromio(virt_addr, carrier->virt_addr, size);
+			} else {
+				memcpy_toio(carrier->virt_addr, virt_addr, size);
+			}
+			pci_epc_unmap_addr(epc, epf->func_no, carrier->phys_addr);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+#endif
+
+static s32 epf_ipc_dmacpy(struct epf_ipc *ipc,
+		void *virt_addr,
+		phys_addr_t phys_addr,
+		u32 size,
+		enum epf_ipc_channels ch,
+		enum dma_data_direction dir)
+{
+	s32 err = 0;
+
+	if ((ipc != NULL) &&
+			(virt_addr != NULL) &&
+			(phys_addr != 0x0ULL) &&
+			(size != 0U)) {
+		struct pci_epf *epf = ipc->epf;
+		struct pci_epc *epc = epf->epc;
+		struct device *dev = epc->dev.parent;
+		dma_addr_t dma_addr;
+
+		dma_addr = dma_map_single(dev, virt_addr, size, dir);
+		if (dma_mapping_error(dev, dma_addr) == 0) {
+			switch (ch) {
+			case EPF_IPC_READ_CHANNEL:
+				err = dolphin_pcie_edma_transfer(epc, size, phys_addr, dma_addr, false, true);
+				if (err == 0) {
+					dma_sync_single_for_cpu(dev, dma_addr, size, dir);
+				}
+				break;
+			case EPF_IPC_WRITE_CHANNEL:
+				err = dolphin_pcie_edma_transfer(epc, size, dma_addr, phys_addr, true, true);
+				if (err == 0) {
+					dma_sync_single_for_device(dev, dma_addr, size, dir);
+				}
+				break;
+			case EPF_IPC_MAX_CHANNEL:
+			default:
+				err = -EIO;
+				break;
+			}
+
+			dma_unmap_single(dev, dma_addr, size, dir);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_read_data(struct epf_ipc *ipc, void *desc, enum epf_ipc_channels ch)
+{
+	s32 err = 0;
+
+	if ((ipc != NULL) &&
+			(desc != NULL)) {
+		phys_addr_t src;
+		u32 size;
+
+		src = pci_ipc_desc_readl(desc, PCI_IPC_DESC_ADDR_LOWER);
+		src |= (((phys_addr_t)pci_ipc_desc_readl(desc, PCI_IPC_DESC_ADDR_UPPER)) << 31);
+		size = pci_ipc_desc_readl(desc, PCI_IPC_DESC_SIZE);
+		if ((src != 0x0ULL) &&
+				(size != 0U)) {
+			void *buf = kzalloc(size, GFP_KERNEL);
+
+			if (buf != NULL) {
+#ifdef USE_CPU_MEMCPY
+				err = epf_ipc_memcpy(ipc, buf, src, size, ch);
+#else
+				err = epf_ipc_dmacpy(ipc, buf, src, size, ch,
+						DMA_FROM_DEVICE);
+#endif
+				if ((err == 0) && ipc->use_netdev) {
+					err = epf_ipc_netdev_callback(ipc, buf, size);
+				}
+				kfree(buf);
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_write_data(struct epf_ipc *ipc, void *desc, void *buf, u32 size, enum epf_ipc_channels ch)
+{
+	s32 err = 0;
+
+	if ((ipc != NULL) &&
+			(desc != NULL) &&
+			(buf != NULL) &&
+			(size != 0U)) {
+		phys_addr_t dst;
+
+		dst = pci_ipc_desc_readl(desc, PCI_IPC_DESC_ADDR_LOWER);
+		dst |= (((phys_addr_t)pci_ipc_desc_readl(desc,PCI_IPC_DESC_ADDR_UPPER)) << 31);
+		if (dst != 0x0ULL) {
+#ifdef USE_CPU_MEMCPY
+			err = epf_ipc_memcpy(ipc, buf, dst, size, ch);
+#else
+			err = epf_ipc_dmacpy(ipc, buf, dst, size, ch, DMA_TO_DEVICE);
+#endif
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static void epf_ipc_cmd_handler(struct work_struct *work)
+{
+	struct epf_ipc *ipc = container_of(work,
+			struct epf_ipc, cmd_hdl.work);
+	const struct pci_epf *epf = (const struct pci_epf *)ipc->epf;
+	enum epf_ipc_channels ch = EPF_IPC_READ_CHANNEL;
+	u32 val;
+
+	val = 0x0U;
+	do {
+		s32 rx_pending = epf_ipc_get_desc_idx(ipc, ch);
+
+		if (rx_pending < 0) {
+			val = 0x0U;
+		} else {
+			u32 offset = ((u32)rx_pending * (u32)sizeof(struct pci_ipc_desc));
+
+			if (offset < epf->bar[ch].size) {
+				void __iomem *desc = ipc->bar[ch] + offset;
+
+				val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL);
+				if ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) != 0x0U) {
+					if (epf_ipc_read_data(ipc, desc, ch) == 0) {
+						epf_ipc_update_desc(ipc, desc, ch, 0 /* Not used */);
+					}
+				}
+			}
+		}
+	} while ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) != 0x0U);
+
+	(void)queue_delayed_work(ipc->rx_wq, &ipc->cmd_hdl, msecs_to_jiffies(1));
+}
+
+static s32 epf_ipc_alloc_space(struct pci_epf *epf,
+		const struct pci_epc_features *epc_features)
+{
+	s32 err = 0;
+
+	if ((epf != NULL) && (epc_features != NULL)) {
+		struct epf_ipc *ipc = (struct epf_ipc *)epf_get_drvdata(epf);
+		void __iomem *base = NULL;
+		s32 ch;
+
+		for (ch = EPF_IPC_READ_CHANNEL; ch < EPF_IPC_MAX_CHANNEL; ch++) {
+			struct pci_epf_bar *epf_bar = &epf->bar[ch];
+
+			base  = pci_epf_alloc_space(epf, epf_bar->size,
+					epf_bar->barno, epc_features->align);
+			if (base != NULL) {
+				ipc->bar[ch] = base;
+			} else {
+				err = -ENOMEM;
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_configure_bar(struct pci_epf *epf)
+{
+	s32 err = 0;
+
+	if (epf != NULL) {
+		s32 ch;
+
+		for (ch = EPF_IPC_READ_CHANNEL; ch < EPF_IPC_MAX_CHANNEL; ch++) {
+			struct pci_epf_bar *epf_bar = &epf->bar[ch];
+
+			epf_bar->barno = (enum pci_barno)ch;
+			epf_bar->size = EPF_IPC_BAR_SIZE;
+			if (upper_32_bits(epf_bar->size) != 0x0U) {
+				epf_bar->flags |= PCI_BASE_ADDRESS_MEM_TYPE_64;
+			} else {
+				epf_bar->flags |= PCI_BASE_ADDRESS_MEM_TYPE_32;
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_set_bar(struct pci_epf *epf)
+{
+	s32 err = 0;
+
+	if (epf != NULL) {
+		const struct epf_ipc *ipc = (const struct epf_ipc *)epf_get_drvdata(epf);
+		struct pci_epc *epc = epf->epc;
+		enum epf_ipc_channels ch;
+
+		for (ch = EPF_IPC_READ_CHANNEL; ch < EPF_IPC_MAX_CHANNEL; ch++) {
+			struct pci_epf_bar *epf_bar = &epf->bar[ch];
+
+			err = pci_epc_set_bar(epc, epf->func_no, epf_bar);
+			if (err != 0) {
+				pci_epf_free_space(epf, ipc->bar[ch], epf_bar->barno);
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static s32 epf_ipc_alloc_carrier(struct pci_epf *epf, size_t size)
+{
+	s32 err = 0;
+
+	if (epf != NULL) {
+		struct epf_ipc *ipc = epf_get_drvdata(epf);
+		struct pci_epc *epc = epf->epc;
+		enum epf_ipc_channels ch;
+
+		for(ch = EPF_IPC_READ_CHANNEL; ch < EPF_IPC_MAX_CHANNEL; ch++) {
+			struct epf_ipc_carrier *carrier = &ipc->carrier[ch];
+
+			carrier->virt_addr = pci_epc_mem_alloc_addr(epc, &carrier->phys_addr, size);
+			if (carrier->virt_addr != NULL) {
+				atomic_set(&carrier->pending, 0);
+			} else {
+				err = -ENOMEM;
+				break;
+			}
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static void epf_ipc_free_carrier(struct pci_epf *epf, size_t size)
+{
+	if (epf != NULL) {
+		struct epf_ipc *ipc = epf_get_drvdata(epf);
+		struct pci_epc *epc = epf->epc;
+		enum epf_ipc_channels ch;
+
+		for(ch = EPF_IPC_READ_CHANNEL; ch < EPF_IPC_MAX_CHANNEL; ch++) {
+			struct epf_ipc_carrier *carrier = &ipc->carrier[ch];
+
+			pci_epc_mem_free_addr(epc, carrier->phys_addr, carrier->virt_addr, size);
+		}
+	}
+}
+
+static s32 epf_ipc_setup_bar(struct pci_epf *epf,
+		const struct pci_epc_features *epc_features)
+{
+	s32 err = 0;
+
+	if ((epf != NULL) && (epc_features != NULL)) {
+		err = epf_ipc_configure_bar(epf);
+		if (err == 0) {
+			err = epf_ipc_alloc_space(epf, epc_features);
+		}
+
+		if (err == 0) {
+			err = epf_ipc_set_bar(epf);
+		}
+
+		if (err == 0) {
+			err = epf_ipc_alloc_carrier(epf, epc_features->align);
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static void epf_ipc_unbind(struct pci_epf *epf)
+{
+	if (epf != NULL) {
+		struct epf_ipc *ipc = (struct epf_ipc *)epf_get_drvdata(epf);
+		struct pci_epc *epc = epf->epc;
+
+		if (ipc != NULL) {
+			s32 ch;
+
+			if (!cancel_delayed_work(&ipc->cmd_hdl)) {
+				dev_err(&epf->dev, "failed to cancel work\n");
+			}
+
+			pci_epc_stop(epc);
+			epf_ipc_free_carrier(epf, ipc->epc_features->align);
+
+			for (ch = EPF_IPC_READ_CHANNEL; ch < EPF_IPC_MAX_CHANNEL; ch++) {
+				struct pci_epf_bar *epf_bar = &epf->bar[ch];
+
+				if (ipc->bar[ch] != NULL) {
+					pci_epc_clear_bar(epc, epf->func_no, epf_bar);
+					pci_epf_free_space(epf, ipc->bar[ch], epf_bar->barno);
+				}
+			}
+		}
+	}
+}
+
+static int epf_ipc_bind(struct pci_epf *epf)
+{
+	s32 err = 0;
+
+	if (epf != NULL) {
+		const struct pci_epc_features *epc_features;
+		struct epf_ipc *ipc = (struct epf_ipc *)epf_get_drvdata(epf);
+		struct pci_epc *epc = epf->epc;
+
+		epc_features = pci_epc_get_features(epc, epf->func_no);
+		if (epc_features != NULL) {
+			err = pci_epc_write_header(epc, epf->func_no, epf->header);
+			if (err == 0) {
+				err = epf_ipc_setup_bar(epf, epc_features);
+			}
+
+			if (err == 0) {
+				if (epc_features->msi_capable != (u32)0) {
+					err = pci_epc_set_msi(epc, epf->func_no,
+							epf->msi_interrupts);
+				}
+			}
+
+			if (err == 0) {
+				ipc->epc_features = epc_features;
+				epf_global = epf;
+			}
+		} else {
+			err = -EOPNOTSUPP;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static struct pci_epf_ops epf_ipc_ops = {
+	.unbind = epf_ipc_unbind,
+	.bind = epf_ipc_bind,
+};
+
+static struct pci_epf_header epf_ipc_header = {
+	.vendorid	= (u16)PCI_ANY_ID,
+	.deviceid	= (u16)PCI_ANY_ID,
+	.baseclass_code = PCI_BASE_CLASS_MEMORY,
+	.interrupt_pin	= PCI_INTERRUPT_INTA,
+};
+
+static int epf_ipc_probe(struct pci_epf *epf)
+{
+	s32 err = 0;
+
+	if (epf != NULL) {
+		struct epf_ipc *ipc = devm_kzalloc(&epf->dev,
+				sizeof(struct epf_ipc), GFP_KERNEL);
+
+		if (ipc != NULL) {
+			epf->header = &epf_ipc_header;
+			ipc->use_netdev = false;
+			ipc->epf = epf;
+			ipc->rx_wq = alloc_workqueue("epf_ipc_rx", WQ_MEM_RECLAIM  | WQ_HIGHPRI, 0);
+			if (ipc->rx_wq != NULL) {
+				INIT_DELAYED_WORK(&ipc->cmd_hdl, epf_ipc_cmd_handler);
+			} else {
+				err = -ENOMEM;
+			}
+
+			if (err == 0) {
+				epf_set_drvdata(epf, ipc);
+			}
+		}
+	} else {
+		err = -ENODEV;
+	}
+
+	return err;
+}
+
+static const struct pci_epf_device_id epf_ipc_ids[] = {
+	{
+		.name = "epf-ipc",
+	},
+	{},
+};
+
+static struct pci_epf_driver epf_ipc_driver = {
+	.driver = {
+		.name		= "epf-ipc",
+	},
+	.probe = epf_ipc_probe,
+	.id_table = epf_ipc_ids,
+	.ops = &epf_ipc_ops,
+};
+
+s32 pci_epf_ipc_init(void)
+{
+	return pci_epf_register_driver(&epf_ipc_driver);
+}
+
+s32 pci_epf_ipc_release(void)
+{
+	struct pci_epf *epf = __get_pci_epf(&epf_ipc_driver);
+	s32 err = 0;
+
+	if (epf != NULL) {
+		struct epf_ipc *ipc = epf_get_drvdata(epf);
+
+		if (ipc->rx_wq != NULL) {
+			destroy_workqueue(ipc->rx_wq);
+		}
+		pci_epf_unregister_driver(&epf_ipc_driver);
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 pci_epf_ipc_read_data(void *buf, __u32 size)
+{
+	s32 err = 0;
+
+	if (buf != NULL) {
+		struct pci_epf *epf = __get_pci_epf(&epf_ipc_driver);
+
+		if (epf != NULL) {
+			struct epf_ipc *ipc = epf_get_drvdata(epf);
+			enum epf_ipc_channels ch = EPF_IPC_READ_CHANNEL;
+			s32 rx_pending = epf_ipc_get_desc_idx(ipc, EPF_IPC_READ_CHANNEL);
+
+			if (rx_pending >= 0) {
+				u32 offset;
+
+				offset = ((u32)rx_pending * (u32)sizeof(struct pci_ipc_desc));
+				if (offset < epf->bar[ch].size) {
+					void __iomem *desc;
+					u32 val;
+
+					desc = ipc->bar[ch] + offset;
+					val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL);
+					if ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) != 0x0U) {
+						dma_addr_t src;
+
+						src = pci_ipc_desc_readl(desc, PCI_IPC_DESC_ADDR_LOWER);
+						src |= (((dma_addr_t)pci_ipc_desc_readl(desc,PCI_IPC_DESC_ADDR_UPPER)) << 31);
+#ifdef USE_CPU_MEMCPY
+						err = epf_ipc_memcpy(ipc, buf, src, size, ch);
+#else
+						err = epf_ipc_dmacpy(ipc, buf, src, size, ch,
+								DMA_FROM_DEVICE);
+#endif
+						if (err == 0) {
+							epf_ipc_update_desc(ipc, desc, ch, size);
+						}
+					}
+				}
+			}
+		} else {
+			err = -ENODEV;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 pci_epf_ipc_write_data(void *buf, __u32 size)
+{
+	s32 err = 0;
+
+	if (buf != NULL) {
+		struct pci_epf *epf = __get_pci_epf(&epf_ipc_driver);
+
+		if (epf != NULL) {
+			struct epf_ipc *ipc = epf_get_drvdata(epf);
+			enum epf_ipc_channels ch = EPF_IPC_WRITE_CHANNEL;
+			s32 tx_pending = epf_ipc_get_desc_idx(ipc, ch);
+
+			if (tx_pending >= 0) {
+				u32 offset = ((u32)tx_pending * (u32)sizeof(struct pci_ipc_desc));
+
+				if (offset < epf->bar[ch].size) {
+					void __iomem *desc = ipc->bar[ch] + offset;
+					u32 val;
+
+					val = pci_ipc_desc_readl(desc, PCI_IPC_DESC_CONTROL);
+					if ((val & PCI_IPC_DESC_CONTROL_OWN_MASK) == 0x0U) {
+						err = epf_ipc_write_data(ipc, desc, buf, size, ch);
+						if (err == 0) {
+							err = epf_ipc_raise_irq(epf, 1U);
+						}
+
+						if (err == 0) {
+							epf_ipc_update_desc(ipc, desc, ch, size);
+						}
+					}
+				}
+			}
+		} else {
+			err = -ENODEV;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+s32 pci_epf_ipc_register_callback(void *cb_data, pci_ipc_callback_t cb_func)
+{
+	s32 err = 0;
+
+	if ((cb_data != NULL) &&
+			(cb_func != NULL)) {
+		struct pci_epf *epf = __get_pci_epf(&epf_ipc_driver);
+
+		if (epf != NULL) {
+			struct epf_ipc *ipc = epf_get_drvdata(epf);
+
+			ipc->cb_data = cb_data;
+			ipc->cb_func = cb_func;
+			ipc->use_netdev = true;
+			(void)queue_work(ipc->rx_wq, &ipc->cmd_hdl.work);
+		} else {
+			err = -ENODEV;
+		}
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
diff --git a/drivers/misc/telechips/ipc/pci_epf_ipc.h b/drivers/misc/telechips/ipc/pci_epf_ipc.h
new file mode 100644
index 000000000000..ad4d4facd349
--- /dev/null
+++ b/drivers/misc/telechips/ipc/pci_epf_ipc.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#ifndef	PCI_EPF_IPC_H
+#define PCI_EPF_IPC_H
+#include <linux/soc/telechips/pci_ipc.h>
+
+#define EPF_IPC_BAR_SIZE		(0x10000U)
+
+enum epf_ipc_channels {
+	EPF_IPC_READ_CHANNEL =		0,
+	EPF_IPC_WRITE_CHANNEL =		1,
+	EPF_IPC_MAX_CHANNEL =		2,
+};
+
+extern s32 pci_epf_ipc_init(void);
+extern s32 pci_epf_ipc_release(void);
+extern s32 pci_epf_ipc_read_data(void *buf, __u32 size);
+extern s32 pci_epf_ipc_write_data(void *buf, __u32 size);
+extern s32 pci_epf_ipc_register_callback(void *cb_data, pci_ipc_callback_t cb_func);
+#endif /* PCI_EPF_IPC_H */
diff --git a/drivers/misc/telechips/ipc/pci_ipc.c b/drivers/misc/telechips/ipc/pci_ipc.c
new file mode 100644
index 000000000000..9bf697e7b83a
--- /dev/null
+++ b/drivers/misc/telechips/ipc/pci_ipc.c
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#include <linux/crc32.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/errno.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/of.h>
+#include <linux/soc/telechips/pci_ipc.h>
+
+#ifdef CONFIG_PCI_DOLPHIN_EP
+#include "pci_epf_ipc.h"
+#else
+#include "pci_ep_ipc.h"
+#endif
+
+struct pci_ipc {
+	struct miscdevice		*misc;
+	struct mutex		lock;
+};
+
+__s32 pci_ipc_register_callback(void *cb_data, pci_ipc_callback_t cb_func)
+{
+	__s32 err = (s32)0;
+
+	if ((cb_data != NULL) && (cb_func != NULL)) {
+#ifdef CONFIG_PCI_DOLPHIN_EP
+		err = pci_epf_ipc_register_callback(cb_data, cb_func);
+#else
+		err = pci_ep_ipc_register_callback(cb_data, cb_func);
+#endif
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+EXPORT_SYMBOL(pci_ipc_register_callback);
+
+__s32 pci_ipc_write_data_nodev(void *data, __u32 size)
+{
+	__s32 err = (s32)0;
+
+	if ((data != NULL) && (size != 0U)) {
+#ifdef CONFIG_PCI_DOLPHIN_EP
+		err = pci_epf_ipc_write_data(data, size);
+#else
+		err = pci_ep_ipc_write_data(data, size);
+#endif
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+EXPORT_SYMBOL(pci_ipc_write_data_nodev);
+
+static long pci_ipc_ioctl(struct file *filp,
+		unsigned int cmd, unsigned long arg)
+{
+	long err = 0;
+
+	if (filp != NULL) {
+		struct miscdevice *misc = (struct miscdevice *)filp->private_data;
+		struct pci_ipc *ipc = dev_get_drvdata(misc->parent);
+
+		mutex_lock(&ipc->lock);
+		switch (cmd) {
+		case IOCTL_PCIE_IPC_TRANSPORT_DATA:
+		case IOCTL_PCIE_IPC_TRANSPORT_DATA_KERNEL:
+			/* TODO */
+			(void)arg;
+			break;
+		default:
+			dev_err(misc->parent, "INVALID command(%d)\n", cmd);
+			break;
+		}
+		mutex_unlock(&ipc->lock);
+	} else {
+		err = -EINVAL;
+	}
+
+	return err;
+}
+
+static int pci_ipc_release(struct inode *inode, struct file *filp)
+{
+	struct miscdevice *misc = (struct miscdevice *)filp->private_data;
+	struct pci_ipc *ipc = dev_get_drvdata(misc->parent);
+	s32 err = (s32)0;
+
+	(void)inode;
+	(void)ipc;
+
+#ifdef CONFIG_PCI_DOLPHIN_EP
+	err = pci_epf_ipc_release();
+#else
+	err = pci_ep_ipc_release();
+#endif
+
+	return err;
+}
+
+static int pci_ipc_open(struct inode *inode, struct file *filp)
+{
+	struct miscdevice *misc = (struct miscdevice *)filp->private_data;
+	struct pci_ipc *ipc = dev_get_drvdata(misc->parent);
+	s32 err = (s32)0;
+
+	(void)inode;
+	(void)ipc;
+
+	return err;
+}
+
+static const struct file_operations pci_ipc_fops = {
+	.owner = THIS_MODULE,
+	.open = pci_ipc_open,
+	.release = pci_ipc_release,
+	.unlocked_ioctl = pci_ipc_ioctl,
+};
+
+static int pci_ipc_probe(struct platform_device *pdev)
+{
+	s32 err = (s32)0;
+
+	if (pdev != NULL) {
+		struct pci_ipc *ipc = devm_kzalloc(&pdev->dev,
+				sizeof(struct pci_ipc), GFP_KERNEL);
+
+		if (ipc != NULL) {
+			ipc->misc = (struct miscdevice *)devm_kzalloc(&pdev->dev,
+					sizeof(struct miscdevice),
+					GFP_KERNEL);
+			if (ipc->misc != NULL) {
+				ipc->misc->minor = MISC_DYNAMIC_MINOR;
+				ipc->misc->fops = &pci_ipc_fops;
+				ipc->misc->name = pdev->name;
+				ipc->misc->parent = &pdev->dev;
+				err = misc_register(ipc->misc);
+				if (err == (s32)0) {
+					platform_set_drvdata(pdev, ipc);
+					pdev->dev.platform_data = ipc;
+					mutex_init(&ipc->lock);
+#ifdef CONFIG_PCI_DOLPHIN_EP
+				err = pci_epf_ipc_init();
+#else
+				err = pci_ep_ipc_init();
+#endif
+				}
+			} else {
+				err = -ENOMEM;
+			}
+		} else {
+			err = -ENOMEM;
+		}
+	} else {
+		err = -ENODEV;
+	}
+
+	return err;
+}
+
+static int pci_ipc_remove(struct platform_device *pdev)
+{
+	s32 err = (s32)0;
+
+	if (pdev != NULL) {
+		struct pci_ipc *ipc = platform_get_drvdata(pdev);
+
+		if (ipc != NULL) {
+			misc_deregister(ipc->misc);
+			kfree(ipc->misc);
+			kfree(ipc);
+		}
+	} else {
+		err = -ENODEV;
+	}
+
+	return err;
+}
+
+static const struct of_device_id pci_ipc_of_match[] = {
+	{ .compatible = "telechips,pcie-ipc" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, pci_ipc_of_match);
+
+static struct platform_driver pci_ipc_driver = {
+	.probe = pci_ipc_probe,
+	.remove = pci_ipc_remove,
+	.driver = {
+		.name = "pcie-ipc",
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(pci_ipc_of_match),
+	},
+};
+module_platform_driver(pci_ipc_driver);
+
+MODULE_AUTHOR("Telechips Inc.");
+MODULE_DESCRIPTION("Telechips PCIE Inter-Processor Communication driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/telechips/ipc/pci_ipc_desc.h b/drivers/misc/telechips/ipc/pci_ipc_desc.h
new file mode 100644
index 000000000000..282ec384e0ee
--- /dev/null
+++ b/drivers/misc/telechips/ipc/pci_ipc_desc.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) Telechips Inc.
+ */
+
+#ifndef	__PCI_IPC_DESC_H__
+#define __PCI_IPC_DESC_H__
+
+/* Basic descriptor structure for normal and alternate descriptors */
+struct pci_ipc_desc {
+	__le32 des0;
+	__le32 des1;
+	__le32 des2;
+	__le32 des3;
+};
+
+#define DMA_DESC_SIZE		(0x10000U)
+#define PCI_IPC_DESC_RING_SIZE		(64U)
+
+#define PCI_IPC_DESC_ADDR_LOWER		(0x0U)
+#define PCI_IPC_DESC_ADDR_UPPER		(0x04U)
+#define PCI_IPC_DESC_SIZE		(0x08U)
+#define PCI_IPC_DESC_CONTROL		(0x0CU)
+
+#define PCI_IPC_DESC_SIZE_MASK		(0xFFFFFFFFU)
+#define PCI_IPC_DESC_CONTROL_STS_MASK		(0xFFFFU)
+#define PCI_IPC_DESC_CONTROL_STS_SHIFT		(0)
+#define PCI_IPC_DESC_CONTROL_OWN_MASK		(0x80000000U)
+#define PCI_IPC_DESC_CONTROL_OWN_SHIFT		(31)
+
+static inline u32 pci_ipc_desc_readl(void __iomem *base,
+		u32 offset)
+{
+	return readl(base + offset);
+}
+
+static inline void pci_ipc_desc_writel(void __iomem *base,
+		u32 offset, u32 value)
+{
+	writel(value, base + offset);
+}
+#endif /* __PCI_IPC_DESC_H__ */
